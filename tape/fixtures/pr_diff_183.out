+            .chain(view.group_by.iter())
+            .chain(view.sort_by.iter().map(|s| &s.field))
+            .chain(view.visible_fields.iter())
+        {
+            if !known(name) && !missing.contains(&name) {
+                missing.push(name);
+            }
+        }
+        if missing.is_empty() {
+            return None;
+        }
+        let list: Vec<String> = missing.iter().map(|n| format!("{n:?}")).collect();
+        Some(format!(
+            "⚠ view {:?}: no field {}",
+            view.name,
+            list.join(", ")
+        ))
+    }
