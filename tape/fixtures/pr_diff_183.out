+                            other => {
+                                return Err(bad(&format!(
+                                    "unknown layout {other:?}; expected \"board\", \"table\" or \"roadmap\""
+                                )))
+                            }
+                        };
+                    }
+                    "filter" | "columns" | "group-by" => {
+                        let args = string_args(child).map_err(bad)?;
+                        let [value] = args.as_slice() else {
+                            return Err(bad("one argument required"));
