.github.com/users/td72/following{/other_user}","gists_url":"https://api.github.com/users/td72/gists{/gist_id}","starred_url":"https://api.github.com/users/td72/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/td72/subscriptions","organizations_url":"https://api.github.com/users/td72/orgs","repos_url":"https://api.github.com/users/td72/repos","events_url":"https://api.github.com/users/td72/events{/privacy}","received_events_url":"https://api.github.com/users/td72/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-08-30T08:11:54Z","updated_at":"2026-11-05T09:02:39Z","closed_at":"2026-08-30T10:12:36Z","assignee":{"login":"td72","id":12109493,"node_id":"MDQ6VXNlcjEyMTA5NDkz","avatar_url":"https://avatars.githubusercontent.com/u/12109493?v=4","gravatar_id":"","url":"https://api.github.com/users/td72","html_url":"https://github.com/td72","followers_url":"https://api.github.com/users/td72/followers","following_url":"https://api.github.com/users/td72/following{/other_user}","gists_url":"https://api.github.com/users/td72/gists{/gist_id}","starred_url":"https://api.github.com/users/td72/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/td72/subscriptions","organizations_url":"https://api.github.com/users/td72/orgs","repos_url":"https://api.github.com/users/td72/repos","events_url":"https://api.github.com/users/td72/events{/privacy}","received_events_url":"https://api.github.com/users/td72/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"OWNER","active_lock_reason":null,"sub_issues_summary":{"total":4,"completed":4,"percent_completed":100},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## Summary\nA read-only page for GitHub Projects (v2), shown as a board. Boards need the full width, so this is a separate page (slot 7 once #118 folds the Actions page into the GitHub page) rather than a column of the GitHub page. Data comes from `gh project list / view / item-list / field-list --format json`.\n\n`gh project` needs the `project` token scope; when it is missing the page shows a notice suggesting `gh auth refresh -s project` instead of failing.\n\n## Non-goals\n- Read-only, like every vig page: no moving items between columns, no field edits, no item creation / deletion.\n\n## Notes\n- Thanks to the `pages` node, users who do not use Projects can drop it from `pages`.\n- Column order follows the `Status` single-select options as ordered on GitHub; items without a status go into a `No status` column.\n- `gh project item-list --limit` is set high (e.g. 500); when truncated the status bar says `(truncated)`.\n- Demo material: a small project linked to a td72 repository (never a real client project).\n\n## Sub-issues\n- #120 — Projects: page skeleton\n- #121 — Projects: project list pane\n- #122 — Projects: board pane\n- #123 — Projects: item detail pane\n","closed_by":{"login":"td72","id":12109493,"node_id":"MDQ6VXNlcjEyMTA5NDkz","avatar_url":"https://avatars.githubusercontent.com/u/12109493?v=4","gravatar_id":"","url":"https://api.github.com/users/td72","html_url":"https://github.com/td72","followers_url":"https://api.github.com/users/td72/followers","following_url":"https://api.github.com/users/td72/following{/other_user}","gists_url":"https://api.github.com/users/td72/gists{/gist_id}","starred_url":"https://api.github.com/users/td72/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/td72/subscriptions","organizations_url":"https://api.github.com/users/td72/orgs","repos_url":"https://api.github.com/users/td72/repos","events_url":"https://api.github.com/users/td72/events{/privacy}","received_events_url":"https://api.github.com/users/td72/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/td72/vig/issues/119/reaction