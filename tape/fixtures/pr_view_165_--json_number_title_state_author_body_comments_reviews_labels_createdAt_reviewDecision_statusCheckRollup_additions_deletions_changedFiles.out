09-07T08:13:29Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/td72/vig/actions/runs/34099343707/job/101669946651","name":"test (x86_64-unknown-linux-gnu, ubuntu-latest)","startedAt":"2026-09-07T08:12:20Z","status":"COMPLETED","workflowName":"CI"},{"__typename":"CheckRun","completedAt":"2026-09-07T08:13:39Z","conclusion":"SUCCESS","detailsUrl":"https://github.com/td72/vig/actions/runs/34099343707/job/101669946740","name":"test (aarch64-apple-darwin, macos-latest)","startedAt":"2026-09-07T08:12:20Z","status":"COMPLETED","workflowName":"CI"},{"__typename":"CheckRun","completedAt":"2026-09-07T08:29:13Z","conclusion":"SKIPPED","detailsUrl":"https://github.com/td72/vig/actions/runs/34100834210/job/101674669748","name":"homebrew","startedAt":"2026-09-07T08:29:14Z","status":"COMPLETED","workflowName":"Release"}],"title":"✨ Projects: Roadmap layout (timeline over date / iteration fields)"}
