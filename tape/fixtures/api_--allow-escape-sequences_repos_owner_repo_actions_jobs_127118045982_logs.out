2026-11-05T07:45:48.3144212Z ##[group]Run # Not all versions support setting CARGO_REGISTRIES_CRATES_IO_PROTOCOL
2026-11-05T07:45:48.3144559Z [36;1m# Not all versions support setting CARGO_REGISTRIES_CRATES_IO_PROTOCOL[0m
2026-11-05T07:45:48.3144855Z [36;1m# On versions 1.66, 1.67, and 1.68.0-nightly the value "sparse" is still unstable.[0m
2026-11-05T07:45:48.3145275Z [36;1m# https://github.com/dtolnay/rust-toolchain/pull/69#discussion_r1107268108[0m
2026-11-05T07:45:48.3145582Z [36;1m# If we detect an incompatible value, set it to "git" which is always supported.[0m
2026-11-05T07:45:48.3145985Z [36;1mif [[ "rustc 1.99.1 (58cf8f9c3 2026-10-13)" =~ ^rustc\ (1\.6[67]\.|1\.68\.0-nightly) && "${CARGO_REGISTRIES_CRATES_IO_PROTOCOL}" == "sparse" ]]; then[0m
2026-11-05T07:45:48.3146332Z [36;1m  echo "Downgrade cargo registry protocol to git"[0m
2026-11-05T07:45:48.3146560Z [36;1m  echo "CARGO_REGISTRIES_CRATES_IO_PROTOCOL=git" >> $GITHUB_ENV[0m
2026-11-05T07:45:48.3146769Z [36;1mfi[0m
